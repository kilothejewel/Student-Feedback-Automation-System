{
  "name": "Student Feedback Automation Workflow",
  "nodes": [
    {
      "parameters": {
        "content": "## 1. Receive\nThe React form POSTs JSON here.\nThe fields arrive under `$json.body`.",
        "height": 280,
        "width": 220,
        "color": 7
      },
      "id": "note-receive",
      "name": "Note: Receive",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-60, 180]
    },
    {
      "parameters": {
        "content": "## 2. Validate\nAll 5 fields present, email looks valid, rating is 1-5.\nIf not: reply 400 and stop.",
        "height": 340,
        "width": 420,
        "color": 7
      },
      "id": "note-validate",
      "name": "Note: Validate",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [180, 40]
    },
    {
      "parameters": {
        "content": "## 3. Classify\nRating <= 2 -> Needs Attention\nRating > 2 -> Satisfactory",
        "height": 400,
        "width": 440,
        "color": 7
      },
      "id": "note-classify",
      "name": "Note: Classify",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [400, 400]
    },
    {
      "parameters": {
        "content": "## 4. Store\nAppend a row to Google Sheets.",
        "height": 280,
        "width": 220,
        "color": 7
      },
      "id": "note-store",
      "name": "Note: Store",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [860, 420]
    },
    {
      "parameters": {
        "content": "## 5. Notify & respond\nEmail the student a thank-you, then reply 200 so the form shows success.",
        "height": 280,
        "width": 440,
        "color": 7
      },
      "id": "note-notify",
      "name": "Note: Notify",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1100, 420]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "student-feedback",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [0, 300],
      "webhookId": "student-feedback"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.body.studentName }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "v2",
              "leftValue": "={{ $json.body.email }}",
              "rightValue": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "v3",
              "leftValue": "={{ $json.body.courseName }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "v4",
              "leftValue": "={{ $json.body.rating }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "v5",
              "leftValue": "={{ $json.body.rating }}",
              "rightValue": 5,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            },
            {
              "id": "v6",
              "leftValue": "={{ $json.body.message }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "validate-payload",
      "name": "Validate Input",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\": \"error\", \"message\": \"Validation failed: missing or invalid fields.\"}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "error-response",
      "name": "Error Response (400)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 140]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.rating }}",
              "rightValue": 2,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "check-rating",
      "name": "Is Rating <= 2?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 560]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "🚨 Needs Attention"
            }
          ]
        },
        "options": {}
      },
      "id": "set-warning",
      "name": "Tag: Needs Attention",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [680, 460]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "✅ Satisfactory"
            }
          ]
        },
        "options": {}
      },
      "id": "set-satisfied",
      "name": "Tag: Satisfactory",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [680, 640]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "studentName": "={{ $json.body.studentName }}",
            "email": "={{ $json.body.email }}",
            "courseName": "={{ $json.body.courseName }}",
            "rating": "={{ $json.body.rating }}",
            "status": "={{ $json.status }}",
            "message": "={{ $json.body.message }}",
            "submittedAt": "={{ $json.body.submittedAt }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "studentName", "displayName": "studentName", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "email", "displayName": "email", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "courseName", "displayName": "courseName", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "rating", "displayName": "rating", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "status", "displayName": "status", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "message", "displayName": "message", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "submittedAt", "displayName": "submittedAt", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true }
          ]
        },
        "options": {}
      },
      "id": "google-sheets",
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.1,
      "position": [920, 540]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Webhook Trigger').item.json.body.email }}",
        "subject": "Thank you for your feedback!",
        "emailType": "text",
        "message": "=Hi {{ $('Webhook Trigger').item.json.body.studentName }},\n\nThank you for your feedback! Your response has been received successfully.\n\nCourse: {{ $('Webhook Trigger').item.json.body.courseName }}\nYour rating: {{ $('Webhook Trigger').item.json.body.rating }}/5\nYour message: \"{{ $('Webhook Trigger').item.json.body.message }}\"\n\nFeedback like yours helps us keep improving our courses.\n\nBest regards,\nThe Training Team",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "send-email",
      "name": "Send Thank You Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1140, 540]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\": \"success\", \"message\": \"Feedback recorded and email notification sent.\"}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "success-response",
      "name": "Success Response (200)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1360, 540]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          { "node": "Validate Input", "type": "main", "index": 0 }
        ]
      ]
    },
    "Validate Input": {
      "main": [
        [
          { "node": "Is Rating <= 2?", "type": "main", "index": 0 }
        ],
        [
          { "node": "Error Response (400)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Is Rating <= 2?": {
      "main": [
        [
          { "node": "Tag: Needs Attention", "type": "main", "index": 0 }
        ],
        [
          { "node": "Tag: Satisfactory", "type": "main", "index": 0 }
        ]
      ]
    },
    "Tag: Needs Attention": {
      "main": [
        [
          { "node": "Google Sheets", "type": "main", "index": 0 }
        ]
      ]
    },
    "Tag: Satisfactory": {
      "main": [
        [
          { "node": "Google Sheets", "type": "main", "index": 0 }
        ]
      ]
    },
    "Google Sheets": {
      "main": [
        [
          { "node": "Send Thank You Email", "type": "main", "index": 0 }
        ]
      ]
    },
    "Send Thank You Email": {
      "main": [
        [
          { "node": "Success Response (200)", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}