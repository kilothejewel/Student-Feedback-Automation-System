            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tag: ✅ Satisfactory": {
      "main": [
        [
          {
            "node": "Google Sheets Store",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets Store": {
      "main": [
        [
          {
            "node": "Send Discord Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
