{
  "name": "Student Feedback Automation Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "student-feedback",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        360
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.studentName }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "v2",
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "v3",
              "leftValue": "={{ $json.courseName }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "v4",
              "leftValue": "={{ $json.rating }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "v5",
              "leftValue": "={{ $json.message }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "validate-payload",
      "name": "Validate Input",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        470,
        360
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "{\"status\": \"error\", \"message\": \"Validation failed: Missing required fields.\"}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "error-response",
      "name": "Error Response (400)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        680,
        180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.rating }}",
              "rightValue": 2,
              "operator": {
                "type": "number",
                "operation": "lessOrEqual"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-rating",
      "name": "Is Rating <= 2?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        470
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "🚨 Needs Attention"
            }
          ]
        },
        "options": {}
      },
      "id": "set-warning",
      "name": "Tag: Needs Attention",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        900,
        380
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "✅ Satisfactory"
            }
          ]
        },
        "options": {}
      },
      "id": "set-satisfied",
      "name": "Tag: Satisfactory",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        900,
        560
      ]
    },
    {
      "parameters": {},
      "id": "merge-branches",
      "name": "Merge Paths",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        1120,
        470
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "studentName": "={{ $json.studentName }}",
            "email": "={{ $json.email }}",
            "courseName": "={{ $json.courseName }}",
            "rating": "={{ $json.rating }}",
            "status": "={{ $json.status }}",
            "message": "={{ $json.message }}",
            "submittedAt": "={{ $json.submittedAt }}"
          },
          "matchingColumns": []
        },
        "options": {}
      },
      "id": "google-sheets",
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.1,
      "position": [
        1300,
        470
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "Thank you for your feedback!",
        "message": "Hi {{ $json.studentName }},\n\nThank you for sharing your experience in our course \"{{ $json.courseName }}\".\n\nWe have successfully received your feedback message:\n\"{{ $json.message }}\"\n\nWe recorded your rating of {{ $json.rating }}/5 stars. Feedback like yours helps us continuously improve our curriculum.\n\nBest regards,\nThe Training Team",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Thank You Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1500,
        470
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "{\"status\": \"success\", \"message\": \"Feedback recorded and email notification sent.\"}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "success-response",
      "name": "Success Response (200)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1700,
        470
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Validate Input",
            "type": "main",
            "index": 0
          }
